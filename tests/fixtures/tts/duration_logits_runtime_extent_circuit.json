{
  "version": 3,
  "name": "duration_logits_runtime_extent_synthetic",
  "family": "bounded_graph",
  "contract": {
    "runtime_invariants": {
      "inference_only": true,
      "production_kernel_heap_allocation": false,
      "valid_extent": "checked_sigmoid_sum_round_before_any_expansion_write"
    }
  },
  "activation_buffers": {
    "audio_duration_logits": {
      "shape": [
        36,
        50
      ]
    },
    "runtime_values": {
      "shape": [
        36
      ]
    },
    "runtime_valid_extent": {
      "shape": [
        1
      ]
    },
    "audio_features": {
      "shape": [
        2,
        36
      ]
    },
    "audio_expanded": {
      "shape": [
        2,
        128
      ]
    },
    "runtime_valid_copy": {
      "shape": [
        2,
        128
      ]
    }
  },
  "activation_bindings": {
    "audio_duration_logits": "audio_duration_logits",
    "runtime_values": "runtime_values",
    "runtime_valid_extent": "runtime_valid_extent",
    "audio_features": "audio_features",
    "audio_expanded": "audio_expanded",
    "runtime_valid_copy": "runtime_valid_copy"
  },
  "native_entry": {
    "function": "ck_test_duration_logits_graph",
    "params": [
      {
        "c_type": "uint8_t *",
        "name": "arena"
      },
      {
        "c_type": "size_t",
        "name": "arena_bytes"
      },
      {
        "c_type": "int32_t *",
        "name": "out_frames"
      }
    ],
    "arena": {
      "pointer": "arena",
      "bytes": "arena_bytes"
    },
    "runtime_length_outputs": {
      "expanded_frames": "out_frames"
    }
  },
  "runtime_lengths": {
    "expanded_frames": {
      "producer": "duration_logits",
      "result": "expanded_frames",
      "capacity": 128,
      "allow_zero": false
    }
  },
  "runtime_views": {
    "expanded": {
      "buffer": "audio_expanded",
      "length": "expanded_frames",
      "channels": 2,
      "physical_stride": 128,
      "element_bytes": 4,
      "buffer_bytes": 1024
    }
  },
  "runtime_constants": {
    "logit_elements": 1800,
    "phoneme_count": 36,
    "logit_stride": 50,
    "duration_capacity": 36,
    "max_duration": 50,
    "expanded_capacity": 128,
    "output_elements": 256,
    "input_elements": 72,
    "input_stride": 36,
    "output_stride": 128,
    "channels": 2,
    "value_elements": 36,
    "expanded_elements": 256,
    "expanded_stride": 128
  },
  "sequence": [
    "bounded_graph"
  ],
  "block_types": {
    "bounded_graph": {
      "sequence": [
        "header",
        "body",
        "footer"
      ],
      "header": [
        {
          "id": "duration_logits",
          "op": "audio_duration_logits_to_frames",
          "kernel": "audio_duration_logits_to_frames_f32",
          "returns_status": true,
          "produces_runtime_lengths": {
            "expanded_frames": "expanded_frames"
          },
          "params": {
            "bins": 50
          },
          "graph_slots": {
            "inputs": {
              "logits": "external:audio_duration_logits"
            },
            "outputs": {
              "durations": "runtime_values",
              "expanded_frames": "runtime_valid_extent"
            }
          }
        }
      ],
      "body": {
        "type": "dense",
        "ops": [
          {
            "id": "expand",
            "op": "audio_duration_expand",
            "kernel": "audio_duration_expand_channel_major_f32",
            "returns_status": true,
            "params": {
              "channels": 2
            },
            "consumes_runtime_lengths": [
              "expanded_frames"
            ],
            "graph_slots": {
              "inputs": {
                "features": "external:audio_features",
                "durations": "runtime_values"
              },
              "outputs": {
                "output": "audio_expanded"
              }
            }
          },
          {
            "id": "consume",
            "op": "runtime_copy_valid",
            "kernel": "runtime_copy_valid_f32",
            "returns_status": true,
            "consumes_runtime_lengths": [
              "expanded_frames"
            ],
            "graph_slots": {
              "inputs": {
                "input": "audio_expanded"
              },
              "outputs": {
                "output": "runtime_valid_copy"
              }
            }
          }
        ]
      },
      "footer": []
    }
  }
}
