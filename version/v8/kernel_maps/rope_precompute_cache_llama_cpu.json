{
  "id": "rope_precompute_cache_llama_cpu",
  "op": "rope_init",
  "variant": "fp32_llama_cpu_recursive_theta",
  "mode": "init",
  "quant": {
    "weight": "none",
    "activation": "fp32",
    "output": "fp32"
  },
  "inputs": [],
  "weights": [],
  "activations": [],
