  "outputs": [
    {
      "name": "cos_cache",
      "dtype": "fp32",
      "shape": ["max_seq_len", "half_rotary_dim"],
      "desc": "llama.cpp-compatible FP32 cosine cache"
    },
    {
      "name": "sin_cache",
      "dtype": "fp32",
      "shape": ["max_seq_len", "half_rotary_dim"],
      "desc": "llama.cpp-compatible FP32 sine cache"
    }
  ],
  "scratch": [],
