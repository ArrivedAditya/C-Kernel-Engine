    "params": [
      {"name": "cos_cache", "source": "output:cos_cache", "cast": "float*"},
      {"name": "sin_cache", "source": "output:sin_cache", "cast": "float*"},
      {"name": "max_seq_len", "source": "dim:max_seq_len"},
