    "deterministic": true
  },
  "impl": {
    "function": "rope_precompute_cache_llama_cpu",
    "c_declaration": "void rope_precompute_cache_llama_cpu(float *cos_cache, float *sin_cache, int max_seq_len, int head_dim, float base, int rotary_dim, const char *scaling_type, float scaling_factor);",
