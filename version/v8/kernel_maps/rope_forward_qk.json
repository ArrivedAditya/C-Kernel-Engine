{
  "id": "rope_forward_qk",
  "op": "rope",
  "operation_interface": "rope.half_split_rotary_dim.fp32.v1",
  "selection": {"status": "production", "priority": 100, "equivalence_group": "rope.half_split_rotary_dim.fp32.v1", "phases": ["prefill", "decode"]},
  "variant": "fp32_head_major",
  "quant": {
    "weight": "none",
    "activation": "fp32",
    "output": "fp32"
  },
  "inputs": [
    {"name": "q", "dtype": "fp32", "shape": ["H", "T", "D"], "layout": "head_major_contiguous", "access": "read", "storage_class": "scratch", "consumption": "required", "desc": "Query tensor [heads, tokens, head_dim] to be rotated in-place"},
    {"name": "k", "dtype": "fp32", "shape": ["KV", "T", "D"], "layout": "head_major_contiguous", "access": "read", "storage_class": "scratch", "consumption": "required", "desc": "Key tensor [kv_heads, tokens, head_dim] to be rotated in-place"},
    {"name": "cos_cache", "dtype": "fp32", "shape": ["max_T", "rotary_dim", 2], "layout": "row_major", "access": "read", "storage_class": "activation", "consumption": "required", "desc": "RoPE cos cache [max_seq, rotary_dim/2]; read-only precomputed cos/sin cache"},
    {"name": "sin_cache", "dtype": "fp32", "shape": ["max_T", "rotary_dim", 2], "layout": "row_major", "access": "read", "storage_class": "activation", "consumption": "required", "desc": "RoPE sin cache [max_seq, rotary_dim/2]; read-only precomputed cos/sin cache"}
  ],
  "weights": [],
  "activations": [],
  "runtime_buffers": [],
  "outputs": [
    {"name": "q", "dtype": "fp32", "shape": ["H", "T", "D"], "layout": "head_major_contiguous", "access": "write", "storage_class": "scratch", "consumption": "required", "alias_of": "input:q", "desc": "Query tensor after RoPE application (in-place)"},
    {"name": "k", "dtype": "fp32", "shape": ["KV", "T", "D"], "layout": "head_major_contiguous", "access": "write", "storage_class": "scratch", "consumption": "required", "alias_of": "input:k", "desc": "Key tensor after RoPE application (in-place)"}
  ],
  "scratch": [],
  "dims": ["H", "KV", "T", "D", "rotary_dim"],
  "params": [
    {"name": "aligned_head_dim", "dtype": "int32", "desc": "Aligned head dimension for SIMD"},
    {"name": "pos_offset", "dtype": "int32", "desc": "Position offset for cos/sin cache lookup"},
    {"name": "rotary_dim", "dtype": "int32", "desc": "RoPE rotary dimensions (only rotate first rotary_dim channels)"}
  ],
  "parallelization": {
    "supported": ["head", "token"],
    "preferred": {"prefill": "head", "decode": "head"},
    "strategies": [
      {
        "name": "head",
        "partition_dim": "H",
        "param_style": "ith_nth",
        "notes": "Parallelize across heads; each thread handles one or more heads."
      },
      {
        "name": "token",
        "partition_dim": "T",
        "param_style": "ith_nth",
        "notes": "Parallelize across tokens; each thread handles one or more tokens."
      }
    ]
  },
  "constraints": {
    "alignment": {"D": 64, "T": 32},
    "notes": "D should be multiple of 64 for optimal SIMD. D is the unpadded dimension; AD is used for alignment."
  },
  "impl": {
    "function": "rope_forward_qk_with_rotary_dim",
    "c_declaration": "void rope_forward_qk_with_rotary_dim(float *q, float *k, const float *cos_cache, const float *sin_cache, int num_heads, int num_kv_heads, int num_tokens, int head_dim, int aligned_head_dim, int pos_offset, int rotary_dim);",
    "sources": ["src/kernels/rope_kernels.c"],
    "variants": [
      {"name": "avx512", "requires": ["avx512f", "fma"], "compile_flags": ["-mavx512f", "-mfma"]},
      {"name": "avx", "requires": ["avx"], "compile_flags": ["-mavx"]},
      {"name": "ref", "requires": [], "compile_flags": []}
    ]
  },
  "call_abi": {"version": 1, "params": [
    {"name": "q", "source": "scratch:q_scratch", "cast": "float*", "ports": ["input:q", "output:q"]},
    {"name": "k", "source": "scratch:k_scratch", "cast": "float*", "ports": ["input:k", "output:k"]},
    {"name": "cos_cache", "source": "runtime:rope_cos", "ports": ["input:cos_cache"]},
    {"name": "sin_cache", "source": "runtime:rope_sin", "ports": ["input:sin_cache"]},
    {"name": "num_heads", "source": "dim:num_heads"},
    {"name": "num_kv_heads", "source": "dim:num_kv_heads"},
    {"name": "num_tokens", "source": "dim:seq_len"},
    {"name": "head_dim", "source": "dim:head_dim"},
    {"name": "aligned_head_dim", "source": "dim:head_dim"},
    {"name": "pos_offset", "source": "runtime:pos"},
    {"name": "rotary_dim", "source": "dim:rotary_dim"}
  ]},
  "tests": {
    "unit": ["unittest/test_rope.py"],
    "bench": ["scripts/bench_rope.py"],
    "parity": [
      {
        "kind": "numpy",
        "command": "python unittest/test_rope.py --compare-numpy",
        "tolerance": "1e-5",
        "notes": "Verify RoPE rotation matches numpy reference"
      }
    ]
  },
  "notes": "Rotary Position Embedding (RoPE) for queries and keys. Applies rotation in complex plane: x_rot = x * cos(theta) + rotate_half(x) * sin(theta). Only rotates first rotary_dim channels; remaining channels pass through unchanged."
}
