    "adapter": "per_activation_row_then_bias",
    "validation": {
      "status": "validated",
      "tests": [
        "unittest/test_q8_composed_llama_parity.py",
        "unittest/test_q8_0_q8_0_x4.py",
        "tests/test_threadpool_parity.c"
      ],
      "external_oracles": [
        {
          "backend": "llama.cpp_ggml_vec_dot_q8_0_q8_0",
