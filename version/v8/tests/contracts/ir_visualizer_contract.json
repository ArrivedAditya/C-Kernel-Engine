{
  "$schema": "visualizer_contract_v1",
  "_testing_guide": "This JSON is the single source of truth for IR visualizer tests. L1 (test_visualizer_health_v8.py) reads tabs/functions/elements from here. L2 (test_visualizer_js_units_v8.py) reads test_vectors. To add a tab: add to tabs[] + required_functions[]. To add a unit-tested function: add to test_vectors{} + update fixtures/ir_pure_functions.js. Run: make v8-visualizer-health",
  "name": "ir_visualizer",
  "description": "CK-Engine v8 IR Visualizer — inference + training tabs",
  "source": "version/v8/tools/ir_visualizer.html",

  "tabs": [
    {
      "id": "memory",
      "label": "Memory",
      "render_fn": "renderMemory",
      "panel_id": "memory",
      "description": "Bump allocator layout, weight/activation memory"
    },
    {
      "id": "kernels",
      "label": "Kernel Flow",
      "render_fn": "renderKernelFlow",
      "panel_id": "kernels",
      "description": "Operator DAG, kernel selection, fusion"
    },
    {
      "id": "stats",
      "label": "Stats",
      "render_fn": "renderStats",
      "panel_id": "stats",
      "description": "FLOP counts, throughput, operator summary"
    },
    {
      "id": "training",
      "label": "Training",
      "render_fn": "renderTraining",
      "panel_id": "training",
      "description": "Loss curves, optimizer state, parity dashboard"
    },
    {
      "id": "quantization",
      "label": "Quantization",
      "render_fn": "renderQuantizationAudit",
      "panel_id": "quantization",
      "description": "Quant format audit, precision analysis"
    },
    {
      "id": "dataflow",
      "label": "Dataflow",
      "render_fn": "renderDataflow",
      "panel_id": "dataflow",
      "description": "Tensor dataflow graph, shape propagation"
    },
    {
      "id": "interpretability",
      "label": "Interpretability",
      "render_fn": "renderOperatorMathIntuition",
      "panel_id": "interpretability",
      "description": "Operator math intuition, transformer anatomy"
    },
    {
      "id": "multimodal",
      "label": "Multimodal",
      "render_fn": "renderMultimodal",
      "panel_id": "multimodal",
      "description": "Vision encoder bridge, prefix embeddings, bridge artifacts"
    },
    {
      "id": "profile",
      "label": "Profile",
      "render_fn": "renderProfile",
      "panel_id": "profile",
      "description": "Decode timing, token/s, VTune/Advisor"
    },
    {
      "id": "data-pipeline",
      "label": "Data Pipeline",
      "render_fn": "renderDataPipeline",
      "panel_id": "data-pipeline",
      "description": "Tokenizer stats, GGUF metadata, model provenance"
    },
    {
      "id": "parity",
      "label": "Parity",
      "render_fn": "renderParityCockpit",
      "panel_id": "parity",
      "description": "CK vs llama.cpp parity results"
    },
    {
      "id": "xray",
      "label": "X-Ray",
      "render_fn": "renderXray",
      "panel_id": "xray",
      "description": "Backend parity X-ray: per-checkpoint numerical drift, ranking, execution trace"
    },
    {
      "id": "tests",
      "label": "Tests",
      "panel_id": "tests",
      "description": "Operator-facing quick/all test entrypoints and debugging commands"
    }
  ],

  "required_functions": {
    "core": [
      "formatBytes",
      "setElText",
      "setElHtml",
      "renderAll",
      "renderActiveTab",
      "renderTabIfDirty",
      "bootstrapFromEmbeddedData",
      "showTab",
      "updateOperatorSummary"
    ],
    "per_tab": [
      "renderMemory",
      "renderKernelFlow",
      "renderStats",
      "renderTraining",
      "renderQuantizationAudit",
      "renderDataflow",
      "renderOperatorMathIntuition",
      "renderMultimodal",
      "getVisionArtifactsPayload",
      "renderVisionPatchGridSvg",
      "renderVisionArtifactsPanel",
      "renderProfile",
      "renderDataPipeline",
      "renderParityCockpit",
      "renderXray",
      "renderXrayContext",
      "renderXrayCircuit",
      "renderXrayRunbook"
    ],
    "utilities": [
      "normalizeShapeInput",
      "formatShapeDisplay",
      "normalizeMode",
      "escapeHtml",
      "quoteShell",
      "normalizePathString",
      "pathDirname",
      "extractGgufStem",
      "relativePathFromTo"
    ]
  },

  "required_dom_elements": [
    "totalWeights",
    "totalActivations",
    "totalMemory",
    "perfFlops",
    "bumpSize",
    "bumpLayers",
    "bumpWeights",
    "xrayBoard",
    "xrayContext",
    "xrayCircuit",
    "xrayDrift",
    "xrayRanking",
    "xrayTrace",
    "xrayRunbook"
  ],

  "pure_function_tests": {
    "fixture_file": "version/v8/tests/fixtures/ir_pure_functions.js",
    "functions": [
      {
        "name": "formatBytes",
        "tests": [
          { "name": "bytes",     "call": "formatBytes(512)",                     "expect": "512 B" },
          { "name": "KB",        "call": "formatBytes(2048)",                    "expect": "2.00 KB" },
          { "name": "MB",        "call": "formatBytes(3 * 1024 * 1024)",         "expect": "3.00 MB" },
          { "name": "GB",        "call": "formatBytes(2.5 * 1024 ** 3)",         "expect": "2.50 GB" }
        ]
      },
      {
        "name": "normalizeShapeInput",
        "tests": [
          { "name": "null",       "call": "normalizeShapeInput(null)",             "expect": [] },
          { "name": "array",      "call": "normalizeShapeInput([2,3,4])",          "expect": ["2","3","4"] },
          { "name": "string",     "call": "normalizeShapeInput('2x3x4')",          "expect": ["2","3","4"] },
          { "name": "bracketed",  "call": "normalizeShapeInput('[2,3,4]')",         "expect": ["2","3","4"] },
          { "name": "number",     "call": "normalizeShapeInput(42)",               "expect": ["42"] },
          { "name": "empty",      "call": "normalizeShapeInput('')",               "expect": [] },
          { "name": "obj_shape",  "call": "normalizeShapeInput({shape:[1,2]})",    "expect": ["1","2"] }
        ]
      },
      {
        "name": "formatShapeDisplay",
        "tests": [
          { "name": "multi",  "call": "formatShapeDisplay([2,3,4])",  "expect": "2 × 3 × 4" },
          { "name": "single", "call": "formatShapeDisplay([5])",      "expect": "[5]" },
          { "name": "empty",  "call": "formatShapeDisplay(null)",     "expect": "-" }
        ]
      },
      {
        "name": "normalizeMode",
        "tests": [
          { "name": "prefill", "call": "normalizeMode('prefill')", "expect": "prefill" },
          { "name": "decode",  "call": "normalizeMode('decode')",  "expect": "decode" },
          { "name": "other",   "call": "normalizeMode('xyz')",     "expect": "decode" }
        ]
      },
      {
        "name": "escapeHtml",
        "tests": [
          { "name": "tags",   "call": "escapeHtml('<b>hi</b>')",  "expect": "&lt;b&gt;hi&lt;/b&gt;" },
          { "name": "quotes", "call": "escapeHtml('a\"b')",       "expect": "a&quot;b" },
          { "name": "null",   "call": "escapeHtml(null)",         "expect": "" }
        ]
      },
      {
        "name": "quoteShell",
        "tests": [
          { "name": "safe",   "call": "quoteShell('hello')",       "expect": "hello" },
          { "name": "spaces", "call": "quoteShell('hello world')", "expect": "\"hello world\"" },
          { "name": "empty",  "call": "quoteShell('')",            "expect": "" }
        ]
      },
      {
        "name": "normalizePathString",
        "tests": [
          { "name": "backslash", "call": "normalizePathString('a\\\\b\\\\c')", "expect": "a/b/c" },
          { "name": "trailing",  "call": "normalizePathString('/a/b/')",       "expect": "/a/b" }
        ]
      },
      {
        "name": "pathDirname",
        "tests": [
          { "name": "basic", "call": "pathDirname('/a/b/c')", "expect": "/a/b" },
          { "name": "root",  "call": "pathDirname('/a')",     "expect": "/" },
          { "name": "empty", "call": "pathDirname('')",       "expect": "" }
        ]
      },
      {
        "name": "extractGgufStem",
        "tests": [
          { "name": "path",     "call": "extractGgufStem('/models/qwen.gguf')",          "expect": "qwen" },
          { "name": "url",      "call": "extractGgufStem('https://x.co/m.gguf?dl=1')",   "expect": "m" },
          { "name": "non_gguf", "call": "extractGgufStem('model.bin')",                   "expect": "" }
        ]
      },
      {
        "name": "relativePathFromTo",
        "tests": [
          { "name": "sibling", "call": "relativePathFromTo('/a/b', '/a/c')",   "expect": "../c" },
          { "name": "child",   "call": "relativePathFromTo('/a/b', '/a/b/c')", "expect": "c" },
          { "name": "same",    "call": "relativePathFromTo('/a/b', '/a/b')",   "expect": "." },
          { "name": "nonabs",  "call": "relativePathFromTo('a/b', '/c')",      "expect": null }
        ]
      },
      {
        "name": "xrayReportKindLabel",
        "tests": [
          { "name": "whisper",  "call": "xrayReportKindLabel({schema:'cke.whisper_encoder_pytorch_xray'})", "expect": "Whisper Encoder X-Ray" },
          { "name": "ranking",  "call": "xrayReportKindLabel({schema:'cke.xray_ranking_report'})",          "expect": "Ranking Report" },
          { "name": "decoder",  "call": "xrayReportKindLabel({schema:'cke.xray.decoder_pytorch'})",         "expect": "Decoder X-Ray" },
          { "name": "fallback", "call": "xrayReportKindLabel({})",                                          "expect": "X-Ray Report" }
        ]
      },
      {
        "name": "xrayBackendLabel",
        "tests": [
          { "name": "whisper_torch",   "call": "xrayBackendLabel({schema:'cke.whisper_encoder_pytorch_xray'})",                          "expect": "PyTorch" },
          { "name": "ranking_oracle",  "call": "xrayBackendLabel({schema:'cke.xray_ranking_report'})",                                     "expect": "ggml-oracle" },
          { "name": "orch_llamacpp",   "call": "xrayBackendLabel({schema:'cke.xray_orchestration_report', final_report:{oracle_backend:'llamacpp'}})", "expect": "llama.cpp" },
          { "name": "orch_pytorch",    "call": "xrayBackendLabel({schema:'cke.xray_orchestration_report', final_report:{oracle_backend:'pytorch'}})",    "expect": "PyTorch" },
          { "name": "trace_backend",   "call": "xrayBackendLabel({schema:'cke.xray_execution_trace', backend:'ck'})",                      "expect": "ck" }
        ]
      },
      {
        "name": "xrayReportStatus",
        "tests": [
          { "name": "explicit",       "call": "xrayReportStatus({status:'pass'})",                                  "expect": "pass" },
          { "name": "checks_all_pass","call": "xrayReportStatus({checks:[{status:'pass'},{status:'pass'}]})",       "expect": "pass" },
          { "name": "checks_one_fail","call": "xrayReportStatus({checks:[{status:'pass'},{status:'fail'}]})",       "expect": "fail" },
          { "name": "unknown",        "call": "xrayReportStatus({})",                                               "expect": "unknown" }
        ]
      },
      {
        "name": "xrayDriftRows",
        "tests": [
          {
            "name": "whisper_checkpoints",
            "call": "xrayDriftRows({checkpoints:[{stop:0, checkpoint:'stem.conv1', layer:null, metrics:{max_abs:0, rmse:0, byte_exact:true, exact_ratio:1}}, {stop:1, checkpoint:'layer.0.mlp.fc1', layer:0, metrics:{max_abs:1.7e-4, rmse:1.8e-5, byte_exact:false, exact_ratio:0.997}}]})",
            "expect_fn": "(r) => r.length === 2 && r[0].label === 'stem.conv1' && r[0].byteExact === true && r[1].layer === 0 && r[1].maxAbs === 1.7e-4 && r[1].rmse === 1.8e-5 && r[1].byteExact === false"
          },
          {
            "name": "orchestration_drift_progression",
            "call": "xrayDriftRows({final_report:{drift_progression:{checkpoints:[{checkpoint_id:'layer.0.input', max_abs:0, rmse:0, byte_exact:true, resolved_execution:{layer:0}}, {checkpoint_id:'layer.0.after_attn', max_abs:2.7e-2, rmse:4.8e-3, byte_exact:false, resolved_execution:{layer:0}}]}}})",
            "expect_fn": "(r) => r.length === 2 && r[0].label === 'layer.0.input' && r[0].byteExact === true && r[1].maxAbs === 2.7e-2 && r[1].layer === 0"
          },
          {
            "name": "empty_for_non_table_report",
            "call": "xrayDriftRows({schema:'cke.xray_ranking_report', checks:[{kind:'teacher_forced'}]})",
            "expect": []
          }
        ]
      },
      {
        "name": "buildXrayRunbookHtml",
        "tests": [
          {
            "name": "empty_state_lists_producer_commands",
            "call": "buildXrayRunbookHtml({runDir:null, modelPath:null})",
            "expect_fn": "(h) => h.indexOf('No X-ray artifacts loaded') >= 0 && h.indexOf('compare_whisper_encoder_pytorch_v8.py') >= 0 && h.indexOf('xray-vision-parity') >= 0 && h.indexOf('xray_execution_state_v8.py') >= 0"
          },
          {
            "name": "no_run_dir_placeholders_escaped",
            "call": "buildXrayRunbookHtml({runDir:null, modelPath:null})",
            "expect_fn": "(h) => h.indexOf('&lt;run_dir&gt;') >= 0 && h.indexOf('<run_dir>') < 0"
          },
          {
            "name": "run_scoped_output_paths",
            "call": "buildXrayRunbookHtml({runDir:'/tmp/ckrun', modelPath:null})",
            "expect_fn": "(h) => h.indexOf('/tmp/ckrun/whisper-encoder-xray.json') >= 0 && h.indexOf('--run /tmp/ckrun') >= 0"
          }
        ]
      },
      {
        "name": "xrayPhaseOf",
        "tests": [
          { "name": "whisper_is_prefill", "call": "xrayPhaseOf({schema:'cke.whisper_encoder_pytorch_xray'})", "expect": "prefill" },
          { "name": "decoder_is_decode",  "call": "xrayPhaseOf({schema:'cke.xray.decoder_pytorch'})",        "expect": "decode" },
          { "name": "run_phase_wins",     "call": "xrayPhaseOf({run:{phase:'teacher_forced'}})",             "expect": "teacher_forced" },
          { "name": "from_comparisons",   "call": "xrayPhaseOf({final_report:{comparisons:[{resolved_execution:{phase:'prefill'}}]}})", "expect": "prefill" },
          { "name": "unknown",            "call": "xrayPhaseOf({schema:'cke.xray_ranking_report', checks:[]})", "expect": null }
        ]
      },
      {
        "name": "xrayContractState",
        "tests": [
          { "name": "match",        "call": "xrayContractState({required_contract:{'numerics.attention_reduction':'fp32_online'}, resolved_contract:{contract_id:'fp32_online'}})", "expect": "match" },
          { "name": "substitution", "call": "xrayContractState({required_contract:{contract_id:'fp32_exact'}, resolved_contract:{contract_id:'fp32_fastgelu'}})", "expect": "substitution" },
          { "name": "unresolved",   "call": "xrayContractState({required_contract:{'execution.phase':'decode'}})", "expect": "unresolved" },
          { "name": "resolved_only","call": "xrayContractState({resolved_contract:{contract_id:'fp32_compute'}})", "expect": "resolved" },
          { "name": "none",         "call": "xrayContractState({op:'matmul'})", "expect": "none" }
        ]
      },
      {
        "name": "xrayCircuitRows",
        "tests": [
          {
            "name": "joins_stops_and_marks_coverage",
            "call": "xrayCircuitRows({operations:[{idx:0, function:'ck_op_conv1d', op:'conv1d', layer:-1, call_abi:{kernel_id:'ck_op_conv1d'}}, {idx:1, function:'ck_op_gelu', op:'gelu', layer:0, call_abi:{kernel_id:'ck_op_gelu'}}]}, [{stop:0, label:'stem.conv1', layer:null, maxAbs:0, rmse:0, byteExact:true, exactRatio:1}], {kernels:[{id:'ck_op_gelu', name:'gelu_fp32'}]})",
            "expect_fn": "(r) => r.length === 2 && r[0].hasCheckpoint === true && r[0].maxAbs === 0 && r[1].hasCheckpoint === false && r[1].maxAbs === null && r[1].provider === 'gelu_fp32' && r[0].provider === 'ck_op_conv1d'"
          },
          {
            "name": "empty_ops",
            "call": "xrayCircuitRows({}, [{stop:0}], null)",
            "expect": []
          }
        ]
      },
      {
        "name": "xrayGrowthEdges",
        "tests": [
          {
            "name": "detects_gt_3x_jump",
            "call": "xrayGrowthEdges([{maxAbs:1e-7},{maxAbs:2e-7},{maxAbs:1.7e-4}], 3)",
            "expect_fn": "(e) => e.length === 1 && e[0].index === 2 && e[0].ratio > 3"
          },
          {
            "name": "skips_zero_prefix",
            "call": "xrayGrowthEdges([{maxAbs:0},{maxAbs:0},{maxAbs:5e-8}], 3)",
            "expect": []
          },
          {
            "name": "monotonic_quiet",
            "call": "xrayGrowthEdges([{maxAbs:1e-7},{maxAbs:2e-7},{maxAbs:2.5e-7}], 3)",
            "expect": []
          }
        ]
      },
      {
        "name": "xrayBoardVerdict",
        "tests": [
          {
            "name": "green_pass",
            "call": "xrayBoardVerdict({status:'pass'}, null)",
            "expect_fn": "(v) => v.level === 'pass'"
          },
          {
            "name": "amber_cosmetic_when_ranking_agrees",
            "call": "xrayBoardVerdict({status:'fail'}, {checks:[{kind:'teacher_forced', position:0, status:'pass', ck_top1:5, oracle_top1:5}]})",
            "expect_fn": "(v) => v.level === 'cosmetic'"
          },
          {
            "name": "red_behavioral_on_flip",
            "call": "xrayBoardVerdict({status:'fail'}, {checks:[{kind:'teacher_forced', position:2, status:'fail', ck_top1:5, oracle_top1:9}]})",
            "expect_fn": "(v) => v.level === 'behavioral' && v.line.indexOf('1 top-1 flip') >= 0"
          },
          {
            "name": "pass_stays_green_even_with_flips",
            "call": "xrayBoardVerdict({status:'pass'}, {checks:[{kind:'mixed_prefill', position:1, status:'fail', ck_top1:1, oracle_top1:2}]})",
            "expect_fn": "(v) => v.level === 'pass'"
          },
          {
            "name": "fail_unclassified_without_ranking",
            "call": "xrayBoardVerdict({status:'diverged'}, null)",
            "expect_fn": "(v) => v.level === 'fail'"
          }
        ]
      }
    ]
  }
}
