{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cke.v8.kernel_physical_layout.schema.json",
  "title": "CKE v8 kernel physical layout capability",
  "type": "object",
  "additionalProperties": false,
  "required": ["layout"],
  "properties": {
    "layout": {
      "enum": [
        "scalar",
        "token_major_contiguous",
        "head_major_contiguous",
        "strided",
        "opaque_packed"
      ]
    },
    "logical_axes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "strides": {
      "type": "array",
      "minItems": 1,
      "items": {"type": ["string", "integer"]}
    },
    "placement": {
      "enum": ["local", "replicated", "sharded", "remote"]
    },
    "partition_axis": {
      "type": "string",
      "minLength": 1
    }
  }
}
